{
  "expo": {
    "name": "DOMY",
    "slug": "domy-app",
    "owner": "ardyscpn",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "domy",
    "newArchEnabled": false,
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FF6B00",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} nuevas notificaciones"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DOMY necesita tu ubicación para calcular rutas y mostrar servicios cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DOMY necesita tu ubicación en segundo plano para rastrear tus entregas en tiempo real.",
        "NSPhotoLibraryUsageDescription": "DOMY necesita acceder a tus fotos para que puedas seleccionar tu foto de perfil.",
        "NSCameraUsageDescription": "DOMY necesita acceder a tu cámara para tomar tu foto de perfil.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.domy.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a la plataforma rastrear tu posición durante las entregas en segundo plano."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B00"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a DOMY acceder a tus fotos para personalizar tu foto de perfil de usuario o conductor."
        }
      ]
    ]
  }
}
