{
  "expo": {
    "name": "DOMY",
    "slug": "domy-app",
    "owner": "ardyscpn",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "domy",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domy.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "DOMY necesita tu ubicación para calcular rutas y mostrar servicios cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "DOMY necesita tu ubicación en segundo plano para rastrear tus entregas en tiempo real.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.domy.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "CALL_PHONE",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a la plataforma rastrear tu posición durante las entregas en segundo plano."
        }
      ]
    ]
  }
}
