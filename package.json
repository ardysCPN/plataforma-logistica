{
  "name": "plataforma-logistica-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:shared && npm run build:backend",
    "build:shared": "npm run build -w @plataforma/shared",
    "build:backend": "npm run build -w @plataforma/backend",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run dev -w @plataforma/backend",
    "dev:app": "npm run dev -w @plataforma/app-universal"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react-native": "0.76.9",
    "@react-native/js-polyfills": "0.76.9",
    "react": "18.3.1",
    "react-native-css-interop": "0.0.36",
    "metro": "0.81.5",
    "metro-resolver": "0.81.5",
    "metro-config": "0.81.5",
    "metro-core": "0.81.5",
    "metro-transform-worker": "0.81.5",
    "metro-source-map": "0.81.5",
    "metro-runtime": "0.81.5"
  },
  "dependencies": {
    "query-string": "7.1.3"
  }
}
